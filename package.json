{
  "name": "planora-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "npm run adb:reset && node scripts/ensure-adb-device.js && npm run android:install && npm run adb",
    "android:rn": "react-native run-android",
    "android:gradle-stop": "cd android && gradlew.bat --stop",
    "android:install": "node scripts/ensure-adb-device.js && cd android && gradlew.bat -I init-ssl.gradle app:installDebug -PreactNativeDevServerPort=8081",
    "android:reset": "powershell -NoProfile -Command \"Remove-Item -Recurse -Force android\\app\\.cxx, android\\app\\build, android\\build -ErrorAction SilentlyContinue\"",
    "android:rebuild": "npm run android:gradle-stop && npm run android:reset && npm run android:install",
    "android:from-legacy": "cd ../ManageTimeApp_React-Native && npm run android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "adb": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:8097 tcp:8097",
    "dev:phone": "npm run adb:reset && npm run adb",
    "adb:reset": "adb kill-server && adb start-server && adb devices",
    "adb:devices": "adb devices",
    "android:build": "cd android && gradlew.bat -I init-ssl.gradle app:assembleDebug -PreactNativeDevServerPort=8081",
    "lint": "eslint . --ext .ts,.tsx",
    "install:fast": "npm install --legacy-peer-deps --no-audit --no-fund --prefer-offline",
    "install:analytics": "npm install @sentry/react-native posthog-react-native --legacy-peer-deps --no-audit",
    "android:release": "cd android && gradlew.bat -I init-ssl.gradle app:bundleRelease"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-firebase/app": "24.0.0",
    "@react-native-firebase/auth": "^24.0.0",
    "@react-native-firebase/messaging": "24.0.0",
    "@react-native-firebase/remote-config": "24.0.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "@sentry/react-native": "^8.13.0",
    "axios": "^1.12.2",
    "date-fns": "^4.1.0",
    "i18next": "^25.8.4",
    "react": "19.1.0",
    "react-i18next": "^16.5.4",
    "react-native": "0.81.4",
    "react-native-blob-util": "^0.24.9",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-keychain": "^10.0.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-localize": "^3.7.0",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "^3.15.0",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.16.0",
    "react-native-share": "^12.3.1",
    "react-native-svg": "^15.14.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-video": "^6.19.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.4",
    "@react-native/metro-config": "0.81.4",
    "@react-native/typescript-config": "0.81.4",
    "@types/react": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
